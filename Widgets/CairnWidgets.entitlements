<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Widgets read the shared snapshot and write completions via App Intents. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.paxton.cairn</string>
    </array>

    <!-- iCloud container so intent-driven writes reach the same CloudKit store. -->
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.paxton.cairn</string>
    </array>

    <!-- macOS sandbox for the extension. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
